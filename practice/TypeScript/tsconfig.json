// add 함수가 파일마다 중복되어서 빨간줄 에러 뜨길래
//  tsconfig.json 파일을 만들어서 typescript 컴파일러 옵션을 설정했습니다!!

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["ts_example.ts"]
}
